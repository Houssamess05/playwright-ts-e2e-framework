				{
					"name": "API 11: POST /api/createAccount",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const timestamp = Date.now();",
									"const dynamicEmail = `user_${timestamp}@gmail.com`;",
									"const dynamicPassword = `Pass_${timestamp}`;",
									"",
									"pm.environment.set(\"tempEmail\", dynamicEmail);",
									"pm.environment.set(\"tempPassword\", dynamicPassword);",
									"pm.environment.set(\"validEmail\", dynamicEmail);",
									"pm.environment.set(\"validPassword\", dynamicPassword);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Response message is 'User created!'\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.responseCode).to.eql(201);",
									"    pm.expect(jsonData.message).to.eql(\"User created!\");",
									"});"
								],
